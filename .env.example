# Readiness — configuration.
#
# Copy this file to `.env` and fill it in. `.env` is git-ignored and must never
# be committed. On a server, set these as environment variables instead.
#
# The app refuses to start if anything required is missing, rather than falling
# back to a default. A compliance product with a guessable signing key is worse
# than one that will not boot.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs session cookies and client portal links. At least 32 characters.
# Generate one with:  npm run setup       (writes a .env for local development)
# or:                 openssl rand -hex 32
# Changing this signs everyone out and invalidates every portal link already
# shared with a client.
SESSION_SECRET=replace-me-with-32-or-more-random-characters

# The address people type into a browser, scheme included, no trailing path.
# Client portal links are absolute URLs that get emailed and pasted around, so
# the origin is configuration rather than something read off a request header.
# REQUIRED when NODE_ENV=production; optional locally.
PUBLIC_URL=https://readiness.example.com

# ---------------------------------------------------------------------------
# Usually set by the platform
# ---------------------------------------------------------------------------

# Port to listen on. Most hosts set this for you.
PORT=3000

# "production" turns on secure cookies, HSTS, and the http -> https redirect.
# Leave unset (or "development") on your own machine, which has no certificate.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where the SQLite database lives. MUST be on a disk that survives restarts and
# redeploys — on a container host that means a mounted volume, not the image.
# Defaults to ./data/readiness.db, which is fine locally and wrong in production.
DATABASE_FILE=/data/readiness.db

# Where `npm run backup` writes. Put it on the same volume so backups survive a
# restart, then copy them off the machine — a backup on the same disk as the
# database does not survive losing that disk.
BACKUP_DIR=/data/backups

# Set this to require an invite code at /signup. Leave it unset and anyone who
# reaches the URL can create their own practice.
SIGNUP_INVITE_CODE=

# Path to Chrome or Chromium, used to render evidence packs as PDFs. Only needed
# if it is somewhere unusual; the app checks the normal locations first. Without
# a browser the PDF download returns a clear message and the pack is still
# available as a web page that any browser can print.
CHROME_PATH=/usr/bin/chromium

# Force the http -> https redirect on or off. Defaults to on in production.
# Set to false only if something in front of you already handles it.
REQUIRE_HTTPS=

# Force the Secure flag on cookies. Defaults to on in production.
SECURE_COOKIES=
