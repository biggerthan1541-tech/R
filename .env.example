# --- Database -------------------------------------------------------------
# Neon / Supabase Postgres connection string.
# Leave EMPTY to run against an embedded PGlite database in ./.pglite (local dev only).
DATABASE_URL=

# --- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Resend (magic links + nag emails) ------------------------------------
AUTH_RESEND_KEY=
RESEND_FROM="Lapse <lapse@yourdomain.com>"

# --- Slack (optional nag channel) -----------------------------------------
SLACK_WEBHOOK_URL=

# --- Cron -----------------------------------------------------------------
# Shared secret required by /api/cron/daily (sent as Authorization: Bearer <secret>).
CRON_SECRET=dev-cron-secret

# Set to 1 to print emails/Slack messages to the console instead of sending them.
DRY_RUN_NOTIFICATIONS=1
