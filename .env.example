# --- Database -------------------------------------------------------------
# Neon (or Supabase) POOLED connection string.
# Leave EMPTY and run `npm run db:local` for an embedded Postgres in ./.pglite.
DATABASE_URL=

# --- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Canonical app URL. Magic links AND reminder links point here — get it right.
AUTH_URL=http://localhost:3000

# --- Resend (magic links + nag emails) ------------------------------------
AUTH_RESEND_KEY=
RESEND_FROM="Lapse <lapse@yourdomain.com>"

# --- Slack (optional nag channel) -----------------------------------------
SLACK_WEBHOOK_URL=

# --- Cron -----------------------------------------------------------------
# Shared secret required by /api/cron/daily (sent as Authorization: Bearer <secret>).
# Vercel Cron sends this automatically once it is set as a project env var.
CRON_SECRET=

# Set to 1 to print emails/Slack messages to the console instead of sending them.
DRY_RUN_NOTIFICATIONS=1

# --- /security trust page -------------------------------------------------
# Stated verbatim on the public /security page. Keep them true.
NEXT_PUBLIC_APP_REGION="Washington, D.C., USA (iad1)"
NEXT_PUBLIC_DB_REGION="AWS us-east-1"
NEXT_PUBLIC_SECURITY_CONTACT="security@yourdomain.com"
NEXT_PUBLIC_TRUST_REVIEWED="2026-08-25"

# --- Seed -----------------------------------------------------------------
# The account the demo workspace is granted to.
SEED_EMAIL=you@example.com
