{
  "name": "readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compliance and cyber-insurance readiness platform for MSPs",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
